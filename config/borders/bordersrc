#!/bin/bash

# JankyBorders configuration.
#
# The palette normally comes from SketchyBar's colors.sh, so the bar and the
# window borders stay in sync -- recolouring one recolours the other. On a
# machine where SketchyBar is not installed, the inline defaults below apply
# instead (same colours), so borders works standalone.

PALETTE="${XDG_CONFIG_HOME:-$HOME/.config}/sketchybar/colors.sh"
[ -f "$PALETTE" ] && source "$PALETTE"

# Only used if colors.sh was absent, or predates these two roles.
: "${BORDER_ACTIVE_COLOR:=0xff00ff9c}"    # focused window   -> bright green
: "${BORDER_INACTIVE_COLOR:=0x00000000}"  # unfocused        -> transparent

options=(
    style=round
    width=3.0
    hidpi=off
    active_color="$BORDER_ACTIVE_COLOR"
    inactive_color="$BORDER_INACTIVE_COLOR"
)

borders "${options[@]}"
